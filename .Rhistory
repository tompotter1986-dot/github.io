for (s in 1:3) {          # looking for s = 1, 2 or 3 sixes
n = 6*s                 # ... in n = 6, 12 or 18 dice
q = pbinom(s-1, n, 1/6) # q = Prob( <s sixes in n dice )
cat("Probability of at least", s, "six in", n, "fair dice:", 1-q, "\n")
}
